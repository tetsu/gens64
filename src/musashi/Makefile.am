# Musashi: Motorola 68000 emulator (portable C core).
# Used instead of Starscream when building with the C core (e.g. x86_64).

AUTOMAKE_OPTIONS = foreign subdir-objects

noinst_LTLIBRARIES = libmusashi.la

# m68kops.c / m68kops.h are generated by m68kmake from m68k_in.c.
# m68kmake runs on the build machine, so it's built with CC_FOR_BUILD.
BUILT_SOURCES = m68kops.c m68kops.h
CLEANFILES = m68kmake$(EXEEXT) m68kops.c m68kops.h

m68kmake$(EXEEXT): $(srcdir)/m68kmake.c
	$(CC_FOR_BUILD) -O2 -o $@ $(srcdir)/m68kmake.c

m68kops.h: m68kops.c
m68kops.c: m68kmake$(EXEEXT) $(srcdir)/m68k_in.c
	./m68kmake$(EXEEXT) . $(srcdir)/m68k_in.c

AM_CPPFLAGS = -I$(srcdir) -I$(builddir) -DMUSASHI_CNF='"m68kconf_gens.h"'

libmusashi_la_CFLAGS	= $(AM_CFLAGS) -static -Wno-unused-parameter -Wno-sign-compare
libmusashi_la_LDFLAGS	= $(AM_LDFLAGS) -static

libmusashi_la_SOURCES = \
		m68kcpu.c \
		softfloat/softfloat.c

nodist_libmusashi_la_SOURCES = \
		m68kops.c

noinst_HEADERS = \
		m68k.h \
		m68kconf.h \
		m68kconf_gens.h \
		m68kcpu.h \
		m68kmmu.h \
		softfloat/milieu.h \
		softfloat/mamesf.h \
		softfloat/softfloat.h

EXTRA_DIST = \
		m68kmake.c \
		m68k_in.c \
		m68kfpu.c \
		m68kdasm.c \
		readme.txt \
		history.txt \
		UPSTREAM_COMMIT.txt \
		softfloat/README.txt \
		softfloat/softfloat-macros \
		softfloat/softfloat-specialize
